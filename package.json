{
  "name": "horus-sdk-monorepo",
  "private": true,
  "description": "Horus TypeScript SDK and CLI",
  "license": "MIT",
  "workspaces": [
    "packages/sdk",
    "packages/cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "npm run generate -w @horusship/sdk",
    "build": "npm run build -w @horusship/sdk && npm run build -w @horusship/cli",
    "typecheck": "npm run typecheck -w @horusship/sdk && npm run typecheck -w @horusship/cli",
    "test": "npm test -w @horusship/sdk && npm test -w @horusship/cli",
    "smoke": "npm run smoke -w @horusship/sdk"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
